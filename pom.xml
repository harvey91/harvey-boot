        <!-- 预发布环境 -->
        <profile>
            <id>pre</id>
            <properties>
                <activeProfile>pre</activeProfile>
                <pName>pre</pName>
            </properties>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
        </profile>
        <!-- 生产环境 -->
